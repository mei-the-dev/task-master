{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique comment identifier"
    },
    "task_id": {
      "type": "integer",
      "description": "ID of the task this comment belongs to"
    },
    "author": {
      "type": "string",
      "description": "GitHub username of comment author"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Comment text content"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Comment creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Comment last update timestamp"
    },
    "parent_id": {
      "type": ["integer", "null"],
      "description": "ID of parent comment for threaded replies"
    },
    "reactions": {
      "type": "object",
      "description": "Reaction counts (thumbs_up, heart, etc.)",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": ["id", "task_id", "author", "content", "created_at"]
}