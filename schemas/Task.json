{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique task identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed task description"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "review", "completed", "blocked"],
      "description": "Current task status"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "urgent"],
      "description": "Task priority level"
    },
    "assignee": {
      "type": "string",
      "description": "GitHub username of assignee"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Task creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "due_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Optional due date"
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Progress percentage"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task tags for categorization"
    },
    "comments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Comment"
      },
      "description": "Task comments"
    }
  },
  "required": ["id", "title", "status", "created_at", "updated_at"],
  "definitions": {
    "Comment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "author": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "author", "content", "created_at"]
    }
  }
}