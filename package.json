{
  "name": "@taskmaster/mcp-server",
  "version": "2.0.0",
  "description": "Model Context Protocol server for GitHub-Native Agentic Framework",
  "type": "module",
  "main": "index.js",
  "bin": {
    "task-master-mcp": "./index.js"
  },
  "scripts": {
    "start": "PATH=./bin:$PATH node index.js",
    "dev": "node --watch index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "github",
    "agent",
    "task-management",
    "ai"
  ],
  "author": "Task-Master Framework",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "mcp": {
    "server": {
      "command": "node",
      "args": [
        "index.js"
      ],
      "env": {
        "GH_TASK_CONTEXT_DIR": ".task-context",
        "GH_PROJECT_NUMBER": "1"
      }
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "babel-jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  }
}
